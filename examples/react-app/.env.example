# Shield remote (relay) pairing. Copy to .env and adjust for the Shield build
# you are testing against. Both values have working defaults in source, so
# .env is only needed to override them.

# Which relay to pair through. Each Shield build allowlists its own set via
# EXPO_PUBLIC_RELAY_ALLOWED_HOSTS (an EAS environment variable, not eas.json):
#   development / preview builds → relay.dev.shield.app
#   production builds           → relay.shield.app
VITE_SHIELD_RELAY_URL=wss://relay.dev.shield.app

# Scheme must match the installed build — the three bundle ids coexist on a
# device and iOS picks non-deterministically between apps claiming a scheme:
#   development → shield-dev://connect
#   preview     → shield-preview://connect
#   production  → shield://connect
# Pointing at the wrong one silently opens the wrong Shield, which then
# rejects the link on its own relay allowlist.
#
# Universal links (https://app.shield.app/connect) are not configured on the
# app yet, so a custom scheme is the only base that opens it.
VITE_SHIELD_DEEPLINK_BASE=shield-preview://connect
