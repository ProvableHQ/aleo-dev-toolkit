{
  "name": "@provablehq/aleo-wallet-algorithms",
  "version": "0.1.0",
  "description": "Standard Aleo wallet algorithms with optional lifecycle and IndexedDB helpers",
  "license": "GPL-3.0-or-later",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProvableHQ/aleo-dev-toolkit.git",
    "directory": "packages/aleo-wallet-algorithms"
  },
  "scripts": {
    "build": "tsup && ALGORITHM_BUILD=mainnet tsup",
    "test": "node --test test/*.test.mjs",
    "lint": "eslint src --ext .ts && prettier --check test scripts tsup.config.ts",
    "typecheck": "tsc --noEmit",
    "test:bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@provablehq/sdk": "0.11.11",
    "@provablehq/aleo-types": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.0.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./program-scoped-blinding-factor": {
